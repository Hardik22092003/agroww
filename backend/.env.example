#############################################
# Agroww Backend Environment Variables (Example)
# Copy this file to `.env` and replace placeholder values.
# NEVER commit the real `.env` file.
#############################################

# Database
# Database
# Local dev (for local Mongo or Docker)
MONGODB_URI=mongodb://localhost:27017/agroww
# Production / Atlas (replace <username>, <password>, <cluster>)
MONGODB_URI_PROD=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agroww

# Server
PORT=5000
NODE_ENV=development

# JWT Secrets
JWT_SECRET=change_this_dev_jwt_secret
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_this_dev_refresh_secret
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Admin Default Credentials
ADMIN_EMAIL=admin@agroww.com
ADMIN_PASSWORD=ChangeThisAdminPassword!

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://agroww.example.com

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
GOOGLE_CALLBACK_URL_PROD=https://api.agroww.example.com/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
GITHUB_CALLBACK_URL_PROD=https://api.agroww.example.com/auth/github/callback

# Session
SESSION_SECRET=change_this_session_secret

# Security Guidance:
# - Replace all placeholder strings in real .env
# - Use long random secrets (>=32 chars) for *_SECRET values
# - Rotate credentials if they were ever committed
# - Set NODE_ENV=production in production deployments
